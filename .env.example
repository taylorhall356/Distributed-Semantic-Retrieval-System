NGINX_HOST_PORT=8080
LOCUST_HOST_PORT=8089
PRELOAD_MODEL_ASSETS=false

DB_HOST=postgres
DB_PORT=5432
DB_NAME=semantic_retrieval
DB_USER=semantic_user
DB_PASSWORD=semantic_password

JWT_SECRET=development-secret-key-at-least-32-bytes

STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=document-storage
MINIO_SECURE=false

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
DOCUMENT_PROCESSING_QUEUE=document_processing
DOCUMENT_PARSING_QUEUE=document_parsing
DOCUMENT_EMBEDDING_QUEUE=document_embedding

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks
QDRANT_QUERY_TIMEOUT_SECONDS=10
QDRANT_QUERY_MAX_RETRIES=2
QDRANT_QUERY_RETRY_DELAY_SECONDS=0.2

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_SERVICE_URL=http://embedding-router:8090
PDF_EXTRACTOR_BACKEND=pymupdf_blocks
EMBEDDING_REQUEST_TIMEOUT_SECONDS=120

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
QUERY_EMBEDDING_CACHE_LOGGING=true

CELERY_WORKER_POOL=prefork
PARSE_WORKER_CONCURRENCY=1
EMBEDDING_WORKER_CONCURRENCY=2
DOCUMENT_PROCESSING_STALE_SECONDS=900

REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
